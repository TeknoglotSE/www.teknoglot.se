{{- /*
  content.json - the data source for Insight.js search.

  Reproduces docs/content.json exactly, in field order, because the file is
  already published and a diff tool reads it byte-wise.

  Top-level key order is meta, pages, posts, categories, tags. JSON objects are
  emitted by hand rather than via jsonify on a map, because Go maps serialise
  with sorted keys and would reorder every object.

  Two orderings are not alphabetical and are worth stating:

    - posts are newest first by date;
    - categories[] and tags[] are in FIRST-ENCOUNTER order, walking the posts
      newest first and taking each post's chains in order. master yields
        ms, Fieldnotes, Fieldnotes/OpsMgr, ms/opsmgr1807, ms/opsmgr1801, ...
      which is exactly the category list of the newest post, then the unseen
      remainder of the second, and so on. Sorting would give a different order.

  path versus permalink: path is the RAW path (lowercase linux, raw unicode for
  the Event-Id post) while permalink is percent-encoded, matching master.

  updated is the last git commit time. master derived it from filesystem
  mtimes, which cannot be reproduced; see LIMITATIONS.md.
*/ -}}
{{- $posts := (where site.RegularPages "Type" "posts").ByDate.Reverse -}}
{{- $base := strings.TrimSuffix "/" site.BaseURL -}}
{{- $topics := where site.Pages "Type" "topic" -}}
{{- $tagpages := where site.Pages "Type" "tagpage" -}}
{{- $catSeen := slice -}}
{{- $tagSeen := slice -}}
{{- range $posts -}}
  {{- range .Params.cats -}}{{- if not (in $catSeen .) -}}{{- $catSeen = $catSeen | append . -}}{{- end -}}{{- end -}}
  {{- range .Params.tags -}}{{- if not (in $tagSeen .) -}}{{- $tagSeen = $tagSeen | append . -}}{{- end -}}{{- end -}}
{{- end -}}
{{- /* resolve a category chain to its leaf, for name and permalink */ -}}
{{- $catName := dict -}}
{{- $catLink := dict -}}
{{- range $topics -}}
  {{- $catName = merge $catName (dict .Params.cat .Title) -}}
  {{- $catLink = merge $catLink (dict .Params.cat (printf "%s%s" $base .RelPermalink)) -}}
{{- end -}}
{{- $tagName := dict -}}
{{- $tagLink := dict -}}
{{- $tagSlug := dict -}}
{{- range $tagpages -}}
  {{- $tagName = merge $tagName (dict .Params.tag .Title) -}}
  {{- $tagLink = merge $tagLink (dict .Params.tag (printf "%s%s" $base .RelPermalink)) -}}
  {{- $tagSlug = merge $tagSlug (dict .Params.tag .Params.tag_slug) -}}
{{- end -}}
{"meta":{"title":{{ printf "%q" site.Title }},"subtitle":null,"description":{{ printf "%q" site.Params.description }},"author":{{ printf "%q" site.Params.author }},"url":{{ printf "%q" $base }},"root":"/"},"pages":[
{{- range $i, $p := (where site.RegularPages "Type" "pages") -}}
{{- $pagePath := strings.TrimPrefix "/" $p.RelPermalink -}}
{{- $pageURL := printf "%s/%sindex.html" $base $pagePath -}}
{{- if $i }},{{ end }}{"title":{{ printf "%q" $p.Title }},"date":{{ printf "%q" ($p.Date.UTC.Format "2006-01-02T15:04:05.000Z") }},"updated":{{ printf "%q" ($p.Lastmod.UTC.Format "2006-01-02T15:04:05.000Z") }},"comments":true,"path":{{ printf "%q" (printf "%sindex.html" $pagePath) }},"permalink":{{ printf "%q" $pageURL }},"excerpt":"","text":{{ printf "%q" (partial "plain-text.html" $p) }}}
{{- end -}}
],"posts":[
{{- range $i, $p := $posts -}}
{{- if $i }},{{ end }}{"title":{{ printf "%q" $p.Title }},"slug":{{ printf "%q" $p.File.ContentBaseName }},"date":{{ printf "%q" ($p.Date.UTC.Format "2006-01-02T15:04:05.000Z") }},"updated":{{ printf "%q" ($p.Lastmod.UTC.Format "2006-01-02T15:04:05.000Z") }},"comments":true,"path":{{ printf "%q" (strings.TrimPrefix "/" $p.Params.url) }},"link":"","permalink":{{ printf "%q" (absURL $p.Params.url) }},"excerpt":{{ printf "%q" $p.Params.excerpt }},"text":{{ printf "%q" (partial "plain-text.html" $p) }},"categories":[
{{- range $j, $c := $p.Params.cats -}}{{- if $j }},{{ end }}{"name":{{ printf "%q" (index $catName $c) }},"slug":{{ printf "%q" $c }},"permalink":{{ printf "%q" (index $catLink $c) }}}{{- end -}}
],"tags":[
{{- range $j, $t := $p.Params.tags -}}{{- if $j }},{{ end }}{"name":{{ printf "%q" (index $tagName $t) }},"slug":{{ printf "%q" (index $tagSlug $t) }},"permalink":{{ printf "%q" (index $tagLink $t) }}}{{- end -}}
]}
{{- end -}}
],"categories":[
{{- range $i, $c := $catSeen -}}{{- if $i }},{{ end }}{"name":{{ printf "%q" (index $catName $c) }},"slug":{{ printf "%q" $c }},"permalink":{{ printf "%q" (index $catLink $c) }}}{{- end -}}
],"tags":[
{{- range $i, $t := $tagSeen -}}{{- if $i }},{{ end }}{"name":{{ printf "%q" (index $tagName $t) }},"slug":{{ printf "%q" (index $tagSlug $t) }},"permalink":{{ printf "%q" (index $tagLink $t) }}}{{- end -}}
]}
